# Sentinel portal credentials -- TEMPLATE. Contains no real values.
#
# Copy to config/sentinel_portal.env (which .gitignore excludes) and fill in:
#
#   cp config/sentinel_portal.env.example config/sentinel_portal.env
#
# Or set the same names as environment variables instead; those take
# precedence over this file. Never put real values in THIS file -- it is
# committed.

# The documented API base URL -- NOT the /resource web page. Still to be
# obtained from the official Sentinel API documentation.
SENTINEL_PORTAL_URL=

# The account the integration signs in as. Use an account issued to this
# system for programmatic access, not a person's own login.
SENTINEL_USERNAME=

SENTINEL_PASSWORD=
